{
  "schema": "rust-anything/front-door@1",
  "name": "metrics-snapshot",
  "commands": [
    "unit-transport",
    "unit-context",
    "unit-expiry",
    "unit-scheduling"
  ],
  "units": [
    {
      "name": "zkc-transport",
      "crate": "zkc-transport-rs",
      "path": "../transport-rs",
      "commands": [
        "unit-transport"
      ],
      "switch": "RUST_ANYTHING_UNIT_ZKC_TRANSPORT"
    },
    {
      "name": "zkc-context-pure",
      "crate": "zkc-context-pure-rs",
      "path": "../context-pure-rs",
      "commands": [
        "unit-context"
      ],
      "switch": "RUST_ANYTHING_UNIT_ZKC_CONTEXT_PURE"
    },
    {
      "name": "zkc-expiry-pure",
      "crate": "zkc-expiry-pure-rs",
      "path": "../expiry-pure-rs",
      "commands": [
        "unit-expiry"
      ],
      "switch": "RUST_ANYTHING_UNIT_ZKC_EXPIRY_PURE"
    },
    {
      "name": "zkc-scheduling-interval",
      "crate": "zkc-scheduling-interval-rs",
      "path": "../scheduling-interval-rs",
      "commands": [
        "unit-scheduling"
      ],
      "switch": "RUST_ANYTHING_UNIT_ZKC_SCHEDULING_INTERVAL"
    }
  ]
}
