<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZKC 每日 E1 驱动（macOS launchd）模板。
  不要手工改 PYTHON / PROJECT_ROOT —— 由 scripts/install_daily_driver.sh 自动解析并替换占位符。
  手动安装（不推荐）：把 __PYTHON__ / __PROJECT_ROOT__ 换成真实绝对路径后，
    cp 本文件 ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.zkc.daily-e1.plist
  默认每天 23:50 跑：真值收口(auto) + 跑 E1 仪表 + 写日志。
  仅自动化"收口 + 仪表"；复审标注(decide)仍须你本人在 /review UI 做。
  日志：<仓库>/logs/e1_daily.log（JSONL，每条一次运行）。
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.zkc.daily-e1</string>
    <key>ProgramArguments</key>
    <array>
      <string>__PYTHON__</string>
      <string>__PROJECT_ROOT__/scripts/daily_e1_driver.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>ZKC_MODE</key>
      <string>direct</string>
      <key>ZKC_BASE</key>
      <string>http://127.0.0.1:8000</string>
      <key>ZKC_STORAGE</key>
      <string>pg</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>23</integer>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/daily_e1.out</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/daily_e1.err</string>
    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
