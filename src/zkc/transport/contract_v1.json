{
  "version": "zkc-mcp-contract/v1",
  "protocolVersion": "2024-11-05",
  "transport": "stdio",
  "egress": [],
  "trustBoundary": "默认 stdio 零网络面、无需 token；外部 agent 一律零信任；写白名单 + 私人 claim 默认脱敏；跨机 HTTP/SSE 须端到端加密隧道，否则不变式⑤（本地优先/隐私）自动否决",
  "capabilities": {
    "tools": {"listChanged": false},
    "resources": {"subscribe": false, "listChanged": false}
  },
  "serverInfo": {"name": "zkc", "version": "0.1.0"},
  "tools": [
    {
      "name": "zkc_capture",
      "description": "agent 显式 push 文档进 ZKC；必须过 DecisionRouter + 双信号弃权 + review_queue 人审分流闸，禁直通道；capture profile 默认开启（只加源节点，不写 interval、不触发 distill、不直写 meta_claim）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "title": {"type": "string"},
                "content": {"type": "string"}
              },
              "required": ["title"]
            }
          }
        },
        "required": ["documents"]
      }
    },
    {
      "name": "zkc_query",
      "description": "只读检索，响应强制带 evidence_refs 溯源；私人 claim 默认脱敏，须显式 scope 授权方可带隐私字段",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50},
          "scope": {"type": "string", "enum": ["public", "private_claims"]}
        },
        "required": ["query"]
      }
    },
    {
      "name": "zkc_review_queue_list",
      "description": "只读列出待复审条目（可按 action 过滤）；repository 只暴露 open 项，不暴露 resolved 历史",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {"type": "integer", "minimum": 1, "maximum": 200},
          "action": {"type": "string", "enum": ["distill", "archive", "abstain", "classify"]}
        }
      }
    },
    {
      "name": "zkc_review_queue_resolve",
      "description": "仅把复审条目标记为 resolved 并记录 HITL 归因；绝不写 interval、不触发 distill、不写 meta_claim",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_id": {"type": "string"},
          "attribution": {"type": "string"}
        },
        "required": ["item_id", "attribution"]
      }
    },
    {
      "name": "zkc_scheduler_due",
      "description": "只读该关注清单：decay 到期、需投入注意力的 node（注意力语义的首个 resource）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "as_of": {"type": "string", "description": "ISO 8601 datetime，缺省取当前时间"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 200}
        }
      }
    }
  ],
  "resources": [
    {
      "uri": "zkc://scheduler/due",
      "name": "该关注清单",
      "description": "注意力语义的首个 resource：decay 到期、需投入注意力的 node 清单",
      "mimeType": "application/json"
    }
  ],
  "blacklist": [
    "distill/trigger",
    "interval_adjustment",
    "meta_claim",
    "history/delete",
    "history/update"
  ]
}
