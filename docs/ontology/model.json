  "rules": [
    {"id": "rule.dual-track-not-bitemporal", "statement": "双轨（静/动分流）≠ 双时态（valid+transaction time），禁止互换", "traces": ["docs/glossary.md", "docs/prds/knowledge-compounding-prd.md"]},
    {"id": "rule.static-decay-zero", "statement": "静态轨 decay_score 恒为 0，不占注意力预算；仅动态轨进入腐化与调度", "traces": ["docs/architecture/ta-data-storage.md", "docs/evidence/architecture-v1.2-source-2026-11-19.md"]},
    {"id": "rule.claim-needs-evidence", "statement": "元认知 claim 必须带 evidence_refs 才能存在（存储层 NOT NULL 强制）", "traces": ["docs/evidence/architecture-v1.2-source-2026-11-19.md", "docs/glossary.md"]},
    {"id": "rule.single-ticket", "statement": "已捕获条目走单程票：28d 观察 → 到期 ARCHIVE，永不回 DISTILL", "traces": ["docs/zj-adr/0002-captured-single-way-ticket.md"]},
    {"id": "rule.interval-three-layers", "statement": "review_interval = L1 基线 × L2 预算归一 × L3 AIMD 反馈；三层各自的触发与边界不得混同", "traces": ["docs/evidence/architecture-v1.2-source-2026-11-19.md", "docs/architecture/ta-data-flow.md"]},
    {"id": "rule.rate-gate", "statement": "标注率 <70% 或样本 <10 时 L3 停机，adapt_interval 不改写 interval", "traces": ["docs/architecture/ta-data-flow.md", "docs/zj-adr/0009-sub-day-interval-lower-bound.md"]},
    {"id": "rule.verdict-v2-terminal", "statement": "changed 与 stale 是不同信号、走 L3 终局动作而非 AIMD 乘因子；changed/stale+cover 写双时态新版本 + 重置 L1 基线且不退出调度回路，stale+purge 走 archive 退出 due", "traces": ["docs/zj-adr/0011-verdict-semantics-v2.md", "docs/zj-adr/0012-verdict-semantics-v2-spec.md"]},
    {"id": "rule.external-anchor-only", "statement": "decay-only 反馈恒 no-op；未标注复审禁写 interval 调整；权重变更须 zj 显式给四分量价值排序外生锚", "traces": ["docs/zj-adr/0011-verdict-semantics-v2.md", "docs/evidence/architecture-v1.2-source-2026-11-19.md"]},
    {"id": "rule.no-physical-delete", "statement": "用户数据无物理删除，仅软归档/墓碑；D2 归档 = 退出调度回路但非恒久 due=0", "traces": ["docs/zj-adr/0013-node-tombstone-soft-delete.md", "docs/evidence/physical-delete-decisions-2026-11-16.md"]},
    {"id": "rule.sim-not-calibrated", "statement": "SIMULATION = 设计口径/占位，非真实行为校准；权重 0.25×4 与 D4=0.65 均标 SIMULATION，不得当既成事实外推", "traces": ["docs/evidence/architecture-v1.2-source-2026-11-19.md", "docs/rec-avoid-gate.md"]},
    {"id": "rule.corpus-derived-not-calibrated", "statement": "corpus-derived ≠ CALIBRATED；语料派生口径不写回 REGISTRY，seed 0.5 仍 PLACEHOLDER 作回退", "traces": ["docs/zj-adr/0013-node-tombstone-soft-delete.md"]},
    {"id": "rule.one-home-per-fact", "statement": "一条规则或解释只有一个权威页，其余页链接到它；派生视图不得与原文构成并行体系", "traces": ["docs/README.md"]},
    {"id": "rule.authority-1to1", "statement": "每个 authority-id 恰好绑定到一个 map 页；一 id 绑两页是机械失败（非零），规范性冲突是 Human-review 信号", "traces": ["docs/README.md"]},
    {"id": "rule.process-not-proof", "statement": "过程态（roadmap/plan/issue）不得作 proof/evidence；结论须先沉淀到 ADR/PRD/架构/risks/evidence", "traces": ["docs/zj-adr/0008-process-authority-boundary.md", "docs/BOUNDARIES.md"]},
    {"id": "rule.evidence-not-durable", "statement": "一次性取证读数、单次 spike 采样、逐字归档不是 durable 事实，不参与产品语义权威判定", "traces": ["docs/README.md"]},
    {"id": "rule.ollama-native-api", "statement": "Ollama 走原生 /api/chat + format:json；/v1 + response_format 对 qwen3.5-mlx 永久挂死；think=false、num_ctx=8192、num_predict 给足", "traces": ["docs/constraints.md"]},
    {"id": "rule.pg-history-explicit-columns", "statement": "history() 用显式列清单 UNION ALL，禁止 SELECT *（列数错位且 embedding_4096 不进历史）", "traces": ["docs/architecture/ta-data-storage.md"]},
    {"id": "rule.risk-lifecycle", "statement": "风险状态变更只在 risks.md（长期单一真相源）维护；R4 保留观察、R6 永久 caveat、R15 已落码守住、R16 ADR-0013 后新增", "traces": ["docs/risks.md"]},
    {"id": "rule.gate-is-floor", "statement": "机械全绿只证明断言一致，不证明内容正确；语义正确性留给 review（a green run is a floor, not a verdict）", "traces": ["docs/README.md"]}
  ],
